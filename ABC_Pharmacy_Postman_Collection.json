{
  "info": {
    "name": "ABC Pharmacy — Salesforce REST API",
    "_postman_id": "abc-pharmacy-api-collection",
    "description": "REST API endpoints for the ABC Pharmacy Salesforce project.\n\nOrg: https://orgfarm-7e74891727-dev-ed.develop.my.salesforce.com\n\nTo authenticate: paste the access token from 'sf org display --target-org pharmaD' into the accessToken collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://orgfarm-7e74891727-dev-ed.develop.my.salesforce.com",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "Paste token from: sf org display --target-org pharmaD"
    },
    {
      "key": "paraId",
      "value": "a01bm00002lMfrdAAC",
      "type": "string",
      "description": "Paracetamol 500mg SF record ID"
    },
    {
      "key": "amoxId",
      "value": "a01bm00002lMftFAAS",
      "type": "string",
      "description": "Amoxicillin 250mg SF record ID"
    }
  ],
  "item": [
    {
      "name": "0 — Auth",
      "item": [
        {
          "name": "Get Access Token (Username-Password Flow)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.access_token) {",
                  "    pm.collectionVariables.set('accessToken', json.access_token);",
                  "    pm.collectionVariables.set('baseUrl', json.instance_url);",
                  "    pm.test('Auth: token received', function() { pm.expect(json.access_token).to.not.be.empty; });",
                  "} else {",
                  "    pm.test('Auth: FAILED - ' + json.error_description, function() { pm.expect.fail(); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "username", "value": "mobaleg474.cloudastick@agentforce.com", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "https://login.salesforce.com/services/oauth2/token",
              "protocol": "https",
              "host": ["login", "salesforce", "com"],
              "path": ["services", "oauth2", "token"]
            },
            "description": "Requires a Connected App with Username-Password flow enabled.\nAlternatively: skip this and paste the token from 'sf org display --target-org pharmaD' directly into the accessToken collection variable."
          }
        }
      ]
    },
    {
      "name": "1 — Products",
      "item": [
        {
          "name": "GET /abc/products — Retrieve Product List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('success flag is true', function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('data array is present', function () {",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "pm.test('count matches data length', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.count).to.equal(body.data.length);",
                  "});",
                  "pm.test('each product has id, name, sku, unitPrice, availableQuantity', function () {",
                  "    pm.response.json().data.forEach(function(p) {",
                  "        pm.expect(p).to.have.all.keys('id','name','sku','unitPrice','availableQuantity');",
                  "        pm.expect(p.availableQuantity).to.be.above(0);",
                  "    });",
                  "});",
                  "pm.test('response time under 3s', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/products",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "products"]
            },
            "description": "Returns all Pharmacy Products with abc_Available_Quantity__c > 0, sorted A-Z.\n\n200 OK: { success, count, data: [{id, name, sku, unitPrice, availableQuantity}] }\n500: { success: false, error }"
          }
        }
      ]
    },
    {
      "name": "2 — Cart",
      "item": [
        {
          "name": "POST /abc/cart — Guest Order by SKU ✅",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate a unique cart ID per run so this test always creates a fresh order",
                  "pm.collectionVariables.set('dynamicCartId', 'CART-GUEST-' + new Date().getTime());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('orderId is returned', function () {",
                  "    pm.expect(pm.response.json().orderId).to.not.be.empty;",
                  "});",
                  "pm.test('orderNumber starts with ORD-', function () {",
                  "    pm.expect(pm.response.json().orderNumber).to.match(/^ORD-/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"{{dynamicCartId}}\",\n  \"guestFirstName\": \"Ahmed\",\n  \"guestLastName\":  \"Ali\",\n  \"governorate\":    \"Giza\",\n  \"city\":           \"Haram\",\n  \"email\":          \"ahmed.ali@example.com\",\n  \"phone\":          \"01112345678\",\n  \"detailedAddress\":\"Building 7, Street 9, District 3\",\n  \"items\": [\n    { \"productId\": \"SKU-PARA-500\", \"quantity\": 3 },\n    { \"productId\": \"SKU-AMOX-250\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Creates a guest order using SKU codes instead of SF record IDs.\nExpected: 201 Created with orderId and orderNumber."
          }
        },
        {
          "name": "POST /abc/cart — Order by SF Record ID ✅",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('dynamicCartIdSF', 'CART-SFID-' + new Date().getTime());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('success is true', function () {",
                  "    pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "pm.test('orderId is returned', function () {",
                  "    pm.expect(pm.response.json().orderId).to.not.be.empty;",
                  "});",
                  "pm.test('orderNumber starts with ORD-', function () {",
                  "    pm.expect(pm.response.json().orderNumber).to.match(/^ORD-/);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"{{dynamicCartIdSF}}\",\n  \"guestFirstName\": \"Sara\",\n  \"guestLastName\":  \"Mahmoud\",\n  \"governorate\":    \"Cairo\",\n  \"city\":           \"Mokattam\",\n  \"email\":          \"sara@example.com\",\n  \"phone\":          \"01001234567\",\n  \"detailedAddress\":\"12 Talaat Harb Street, Downtown Cairo\",\n  \"items\": [\n    { \"productId\": \"{{paraId}}\", \"quantity\": 2 },\n    { \"productId\": \"{{amoxId}}\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Creates an order using Salesforce record IDs as productId.\nExpected: 201 Created."
          }
        },
        {
          "name": "POST /abc/cart — Idempotency (Retry same cartId) ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 OK (already exists)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('message says Cart already exists', function () {",
                  "    pm.expect(pm.response.json().message).to.equal('Cart already exists.');",
                  "});",
                  "pm.test('same orderId returned', function () {",
                  "    pm.expect(pm.response.json().orderId).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"{{dynamicCartId}}\",\n  \"guestFirstName\": \"Ahmed\",\n  \"guestLastName\":  \"Ali\",\n  \"governorate\":    \"Giza\",\n  \"city\":           \"Haram\",\n  \"email\":          \"ahmed.ali@example.com\",\n  \"phone\":          \"01112345678\",\n  \"items\": [\n    { \"productId\": \"SKU-PARA-500\", \"quantity\": 3 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Sends the same externalCartId as the first request.\nExpected: 200 OK with 'Cart already exists.' — no duplicate order created."
          }
        },
        {
          "name": "POST /abc/cart — Error: Empty Items → 400 ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('success is false', function () {",
                  "    pm.expect(pm.response.json().success).to.be.false;",
                  "});",
                  "pm.test('error message present', function () {",
                  "    pm.expect(pm.response.json().error).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"CART-EMPTY-ITEMS\",\n  \"guestFirstName\": \"Test\",\n  \"items\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Sends an empty items array.\nExpected: 400 Bad Request — 'Cart must contain at least one item.'"
          }
        },
        {
          "name": "POST /abc/cart — Error: Product Not Found → 404 ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('success is false', function () {",
                  "    pm.expect(pm.response.json().success).to.be.false;",
                  "});",
                  "pm.test('error mentions the bad SKU', function () {",
                  "    pm.expect(pm.response.json().error).to.include('SKU-DOES-NOT-EXIST');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"CART-404-TEST\",\n  \"guestFirstName\": \"Test\",\n  \"items\": [\n    { \"productId\": \"SKU-DOES-NOT-EXIST\", \"quantity\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Sends a non-existent SKU.\nExpected: 404 Not Found — 'Product not found: SKU-DOES-NOT-EXIST'"
          }
        },
        {
          "name": "POST /abc/cart — Error: Insufficient Stock → 422 ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "pm.test('success is false', function () {",
                  "    pm.expect(pm.response.json().success).to.be.false;",
                  "});",
                  "pm.test('error mentions Insufficient stock', function () {",
                  "    pm.expect(pm.response.json().error).to.include('Insufficient stock');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalCartId\": \"CART-422-TEST\",\n  \"guestFirstName\": \"Test\",\n  \"items\": [\n    { \"productId\": \"SKU-PARA-500\", \"quantity\": 99999 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/services/apexrest/abc/cart",
              "host": ["{{baseUrl}}"],
              "path": ["services", "apexrest", "abc", "cart"]
            },
            "description": "Requests 99999 units of a product with only 200 in stock.\nExpected: 422 Unprocessable Entity — 'Insufficient stock for product: ...'"
          }
        }
      ]
    }
  ]
}
