<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Alerts every active warehouse-profile user that a product just dropped to 1 unit or less in stock.</description>
        <name>abc_Send_Low_Stock_Notification</name>
        <label>Send Low Stock Notification</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <connector>
            <targetReference>abc_Loop_Find_Matching_Product</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>abc_Get_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>abc_col_warehouse_user_ids</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Low Stock Alert</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <elementReference>abc_low_stock_notification_body</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>abc_Loop_Find_Matching_Product.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>customNotificationAction</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Appends the current warehouse user&apos;s Id to the recipient list used by the low-stock notification action.</description>
        <name>abc_collect_warehouse_user_id</name>
        <label>collect warehouse user id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>abc_col_warehouse_user_ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>abc_Loop_Warehouse_Users.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>abc_Loop_Warehouse_Users</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Collects the Product Id referenced by the current line item so every product this order needs can be bulk-queried once, before the main processing loop runs.</description>
        <name>abc_collect_product_id</name>
        <label>collect product id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>abc_col_product_ids</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>abc_Loop_Collect_Product_Ids.abc_Product__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>abc_Loop_Collect_Product_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Subtracts the line item quantity from the matched product&apos;s available stock, then queues the product for the bulk update after the loop.</description>
        <name>abc_decrease_available_quantity</name>
        <label>decrease available quantity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>abc_Loop_Find_Matching_Product.abc_Available_Quantity__c</assignToReference>
            <operator>Subtract</operator>
            <value>
                <elementReference>abc_Loop_Line_Items.abc_Quantity__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>abc_col_products_to_update</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>abc_Loop_Find_Matching_Product</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>abc_is_stock_low</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Fires the warehouse notification only when the matched product&apos;s remaining stock is at or below the reorder threshold of 1.</description>
        <name>abc_is_stock_low</name>
        <label>is stock low (&lt;= 1)?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>abc_Loop_Find_Matching_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>abc_yes_stock_low</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>abc_Loop_Find_Matching_Product.abc_Available_Quantity__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>abc_Send_Low_Stock_Notification</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the product currently being scanned in the pre-fetched products collection is the one referenced by the current line item. No SOQL runs here — it&apos;s a comparison against records already queried in bulk before this loop started.</description>
        <name>abc_Is_Matching_Product</name>
        <label>is matching product?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>abc_Loop_Find_Matching_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>abc_yes_matching_product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>abc_Loop_Find_Matching_Product.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>abc_Loop_Line_Items.abc_Product__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>abc_decrease_available_quantity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>When an Order&apos;s status becomes &apos;In delivery&apos;, deduct each line item&apos;s quantity from the matching product&apos;s Available Quantity (mimicking warehouse stock leaving on delivery) and alert the warehouse team when a product&apos;s remaining stock drops to 1 or less. Every product referenced by the order is bulk-queried once before the loop starts, so no Get Records runs inside the per-line-item loop.</description>
    <environments>Default</environments>
    <interviewLabel>deduct product quantity on delivery {!$Flow.CurrentDateTime}</interviewLabel>
    <label>deduct product quantity on delivery</label>
    <loops>
        <name>abc_Loop_Line_Items</name>
        <label>Loop Through Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>abc_Get_Order_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>abc_Loop_Find_Matching_Product</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>abc_Update_Products</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>abc_Loop_Warehouse_Users</name>
        <label>Loop Through Warehouse Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>abc_Get_Warehouse_Users</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>abc_collect_warehouse_user_id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>abc_Loop_Collect_Product_Ids</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Single pass over the line items to gather every referenced Product Id, so the products can be queried once in bulk instead of once per line item.</description>
        <name>abc_Loop_Collect_Product_Ids</name>
        <label>Loop Through Line Items (Collect Product Ids)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>abc_Get_Order_Line_Items</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>abc_collect_product_id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>abc_Get_Products</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Searches the products collection that was already fetched in bulk before this loop started, looking for the product referenced by the current line item. No SOQL runs inside this loop.</description>
        <name>abc_Loop_Find_Matching_Product</name>
        <label>Loop Through Fetched Products (Find Match)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>abc_Get_Products</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>abc_Is_Matching_Product</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>abc_Loop_Line_Items</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>The org&apos;s Low Stock Alert custom notification type, looked up by developer name so the flow doesn&apos;t hardcode an org-specific record Id.</description>
        <name>abc_Get_Notification_Type</name>
        <label>Get Low Stock Notification Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>abc_Get_Warehouse_Profile</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>abc_low_stock_alert</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>All line items belonging to the order that just entered &apos;In delivery&apos;.</description>
        <name>abc_Get_Order_Line_Items</name>
        <label>Get Order Line Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>abc_Get_Notification_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>abc_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>abc_Order_Line_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Every distinct product referenced by this order&apos;s line items, fetched once in a single bulk query before the main processing loop starts. Replaces the old per-line-item Get Records call that used to run inside the loop.</description>
        <name>abc_Get_Products</name>
        <label>Get Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>abc_Loop_Line_Items</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>abc_col_product_ids</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>abc_Product__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>The warehouse profile&apos;s Id, looked up so the User query below can filter on the plain ProfileId field instead of a cross-object path.</description>
        <name>abc_Get_Warehouse_Profile</name>
        <label>Get Warehouse Profile</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>abc_Get_Warehouse_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>warehouse</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Profile</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Every active user with the warehouse profile, fetched once per order (not per line item) since the recipient list doesn&apos;t change during the loop.</description>
        <name>abc_Get_Warehouse_Users</name>
        <label>Get Warehouse Users</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>abc_Loop_Warehouse_Users</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ProfileId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>abc_Get_Warehouse_Profile.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>User</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Single bulk DML for all products touched by this order&apos;s line items, run once after the loop instead of once per iteration.</description>
        <name>abc_Update_Products</name>
        <label>Update Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>abc_col_products_to_update</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>abc_Get_Order_Line_Items</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>abc_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>In delivery</stringValue>
            </value>
        </filters>
        <object>abc_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>abc_low_stock_notification_body</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!abc_Loop_Find_Matching_Product.Name} is down to {!abc_Loop_Find_Matching_Product.abc_Available_Quantity__c} unit(s) in stock. Reorder soon.</text>
    </textTemplates>
    <variables>
        <name>abc_col_product_ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>abc_col_products_to_update</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>abc_Product__c</objectType>
    </variables>
    <variables>
        <name>abc_col_warehouse_user_ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
